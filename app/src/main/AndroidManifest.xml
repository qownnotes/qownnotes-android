<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QOwnNotesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.QOwnNotes">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
            The application is one activity, and a share has to reach the instance the user is
            looking at, so a share cannot be allowed to stack a second copy of it behind or in
            front of the running one.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Text shared by another application becomes a new note. Every text type is
                accepted, not only `text/plain`, because an application sharing a page or a
                message may label it `text/html` or another subtype while still sending the
                text itself in the intent, and what is read from it is plain text either way.
            -->
            <intent-filter android:label="@string/share_to_new_note">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CaptureNoteActivity"
            android:exported="false"
            android:theme="@style/Theme.QOwnNotes" />
        <activity
            android:name=".WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.QOwnNotes" />
        <activity
            android:name=".WidgetConfigurationActivity"
            android:exported="true"
            android:theme="@style/Theme.QOwnNotes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".NoteListWidgetProvider"
            android:exported="true"
            android:label="@string/widget_note_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/note_list_widget_info" />
        </receiver>
        <receiver
            android:name=".SingleNoteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_single_note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_note_widget_info" />
        </receiver>
        <service
            android:name=".NoteListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service
            android:name=".SingleNoteWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
